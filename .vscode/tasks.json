{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Hardware Test Log Analyzer dashboard",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/streamlit",
      "args": ["run", "${workspaceFolder}/app.py"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run project tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "args": ["-q"],
      "problemMatcher": []
    },
    {
      "label": "Evaluate local triage rules",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${workspaceFolder}/scripts/evaluate_diagnosis.py"],
      "problemMatcher": []
    }
  ]
}
